# Những thứ KHÔNG được copy vào build context / image.
# Giữ lại: app/, utils/, requirements.txt — image cần chúng để chạy.

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Git
.git
.gitignore
.github

# Python
__pycache__
*.py[cod]
.venv
venv
env
.pytest_cache
*.egg-info

# Không cần trong image runtime
tests
screenshots
nginx
*.md
Dockerfile*
docker-compose.yml
railway.toml
render.yaml
grade.py

# OS / editor
.DS_Store
.idea
.vscode
*.log
